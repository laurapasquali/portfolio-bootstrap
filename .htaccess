# =====================================================
#   .htaccess di laurapasquali.it
#   Le vecchie regole di WordPress sono state tolte: il sito è statico (HTML, CSS, JS)
#   e usa PHP solo per invia.php, il modulo di contatto.
# =====================================================


# ---- 1. PHP: blocco di Serverplan, da non modificare ----
# dice al server quale versione di PHP usare per i file .php

# SP BEGIN php handler
<IfModule mod_fcgid.c>
          AddHandler fcgid-script .php .php5 .php7 .phtml
          FcgidWrapper    /usr/local/cpanel/cgi-sys/sp-ea-php85 .php
          FcgidWrapper    /usr/local/cpanel/cgi-sys/sp-ea-php85 .php5
          FcgidWrapper    /usr/local/cpanel/cgi-sys/sp-ea-php85 .php7
          FcgidWrapper    /usr/local/cpanel/cgi-sys/sp-ea-php85 .phtml
</IfModule>
# SP END php handler


# ---- 2. un solo indirizzo: https://laurapasquali.it ----
# http:// e www. portano tutti a https://laurapasquali.it con un unico redirect 301
# (anche http://www., che ha bisogno di entrambe le correzioni).
# La cartella .well-known è esclusa: serve al rinnovo automatico del certificato SSL.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # la vecchia pagina contatti non c'è più: chi ha il vecchio link arriva al modulo della home.
  # NE: il # resta un # e non diventa %23
  RewriteRule ^contatti\.html$ https://laurapasquali.it/#form [R=301,L,NE]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://laurapasquali.it%{REQUEST_URI} [L,R=301]
</IfModule>


# ---- 3. modulo di contatto: file da non aprire dal browser ----

# cartella phpmailer/: la usa solo invia.php dal server, nessuno deve aprirla dal browser
RedirectMatch 403 ^/phpmailer(/|$)

# configurazione con la password SMTP (in caso venisse caricata per sbaglio dentro public_html)
<FilesMatch "^config-mail.*\.php$">
  Require all denied
</FilesMatch>


# ---- 4. pagina di errore per gli indirizzi che non esistono ----
# 404.html usa percorsi dalla radice (/css/…, /img/…): funziona anche dentro le sottocartelle
ErrorDocument 404 /404.html


# ---- 5. niente elenco dei file ----
# una cartella senza index.html non mostra la lista dei file che contiene
Options -Indexes


# ---- 6. cache del browser ----
# il browser tiene in memoria i file che cambiano di rado, così le pagine si caricano prima.
# Durate: font 1 anno, immagini 1 mese, CSS e JavaScript 1 settimana, HTML nessuna cache.
# ATTENZIONE: se modifichi style.css, home.css o un'immagine tenendo lo stesso nome,
# chi è già passato dal sito può vedere la versione vecchia fino alla scadenza
# (al massimo 1 settimana per CSS e JS, 1 mese per le immagini).
<IfModule mod_expires.c>
  ExpiresActive On

  # immagini: 1 mese
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # font: 1 anno (i .ttf hanno nomi diversi a seconda del server, per questo sono tre)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType application/font-sfnt "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # CSS e JavaScript: 1 settimana
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"

  # pagine HTML: nessuna cache lunga, così i testi aggiornati si vedono subito
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
